[Project]
Current Flow=Multivendor
VCS=0
version=4
Current Config=compile
[Configurations]
compile=CA
[Library]
CA=.\CA\CA.lib
[$LibMap$]
CA=.
Active_lib=
[Settings]
FLOW_TYPE=HDL
LANGUAGE=VHDL
REFRESH_FLOW=1
FLOWTOOLS=ONLY_IMPL
ON_SERVERFARM_SYNTH=0
ON_SERVERFARM_IMPL=0
ON_SERVERFARM_SIM=0
[IMPLEMENTATION]
UCF=
[Files]
/Morris_Computer_Top.vhd=-1
/Datapath.vhd=-1
/Control_Unit.vhd=-1
/ALU.vhd=-1
/RAM_4K.vhd=-1
/Testbench.vhd=-1
/untitled.awc=-1
/test.asdb=-1
/test.awc=-1
[Files.Data]
.\src\Morris_Computer_Top.vhd=VHDL Source Code
.\src\Datapath.vhd=VHDL Source Code
.\src\Control_Unit.vhd=VHDL Source Code
.\src\ALU.vhd=VHDL Source Code
.\src\RAM_4K.vhd=VHDL Source Code
.\src\Testbench.vhd=VHDL Source Code
.\src\untitled.awc=Accelerated Waveform Configuration
.\src\test.asdb=Accelerated Waveform File
.\src\test.awc=Accelerated Waveform Configuration
[HierarchyViewer]
HierarchyInformation=testbench|Behavioral|0
ShowHide=ShowTopLevel
Selected=
[LocalVhdlSets]
NetlistCompilation=1
EnableVHDL93Key=0
EnableVHDL2002Key=1
EnableVHDL2008Key=0
EnableVHDL2019Key=0
DisableVHDL87Key=0
Syntax RelaxLRM=0
MaxErrorsKey=100
CompileWithDebug=0
OptimizationLevel=3
DisableRangeChecks=0
ProtectLevel=0
IncrementalCompilation=0
AdditionalOptions=
ReorderOnFirstRebuild=1
ElaborationAfterCompilation=0
PrintErrWarnOnly=0
GenMultiplatformLib=0
VhdlPreservePortComments=0
